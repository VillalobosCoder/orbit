{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "bootstrap:admin": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-admin.ts",
    "migration:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate --config=src/infrastructure/db/config.ts",
    "migration:run": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate --config=src/infrastructure/db/config.ts"
  },
  "dependencies": {
    "@orbit/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
